# Base URL of the agent-server
AGENT_SERVER_URL=http://localhost:8001
# Seconds to wait for an agent reply
REQUEST_TIMEOUT_SECONDS=120

# --- OIDC login (Keycloak) — values from keycloak/setup_keycloak.py ---
OIDC_KEYCLOAK_URL=http://localhost:8080
OIDC_REALM=master
OIDC_CLIENT_ID=streamlit-ui
OIDC_CLIENT_SECRET=streamlit-ui-secret
# Must exactly match a redirect URI registered on the streamlit-ui client
OIDC_REDIRECT_URI=http://localhost:8501/
# Requesting the calculator scope makes Keycloak stamp the token with the
# MCP + agent audiences (least privilege: only what the tools need)
OIDC_SCOPES=openid profile email calculator:use
