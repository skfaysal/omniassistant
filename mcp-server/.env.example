# --- Auth server (Keycloak — see keycloak/docker-compose.yml) ---
MCP_AUTH_HOST=localhost
MCP_AUTH_PORT=8080
MCP_AUTH_REALM=master

# Confidential client used for RFC 7662 token introspection.
# Created by keycloak/setup_keycloak.py; the secret is REQUIRED
# (startup validation fails fast if missing).
MCP_OAUTH_CLIENT_ID=mcp-server
MCP_OAUTH_CLIENT_SECRET=mcp-server-secret

# Canonical resource URI of this MCP server (RFC 8707 resource indicator —
# must equal the audience Keycloak's mapper embeds in tokens)
MCP_RESOURCE_URL=http://localhost:8000/mcp

# --- Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- Gateway ---
# Requests per minute allowed per user / IP
MCP_RATE_LIMIT_RPM=60
# Comma-separated allowed CORS origins
MCP_CORS_ORIGINS=http://localhost:8501,http://localhost:8001
# Circuit breaker: consecutive failures before the circuit opens
MCP_CIRCUIT_FAILURE_THRESHOLD=5
# Circuit breaker: seconds before a half-open probe is allowed
MCP_CIRCUIT_RECOVERY_SECONDS=30

# --- Observability ---
MCP_LOG_LEVEL=INFO
# Set to true to print OpenTelemetry spans to stdout
MCP_OTEL_CONSOLE_EXPORT=false
