# --- Required (startup fails fast if missing) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Confidential client the agent uses to introspect the user's token
# (created by keycloak/setup_keycloak.py)
AGENT_OAUTH_CLIENT_SECRET=agent-server-secret

# --- LLM ---
# Any langchain init_chat_model identifier, e.g. anthropic:claude-sonnet-5
AGENT_LLM_MODEL=anthropic:claude-sonnet-5

# --- MCP server (the secure remote calculator) ---
AGENT_MCP_SERVER_URL=http://localhost:8000/mcp

# --- Auth server (Keycloak) ---
AGENT_AUTH_HOST=localhost
AGENT_AUTH_PORT=8080
AGENT_AUTH_REALM=master
AGENT_OAUTH_CLIENT_ID=agent-server
# This agent's canonical resource URL — the audience user tokens must carry
AGENT_RESOURCE_URL=http://localhost:8001
# Scope required to call /chat
AGENT_REQUIRED_SCOPE=calculator:use

# --- Server ---
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
AGENT_LOG_LEVEL=INFO
